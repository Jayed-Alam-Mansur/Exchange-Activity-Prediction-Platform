# --- Project artefacts -------------------------------------------------------
# Raw API payloads are excluded: 8 MB, fully regenerable via `make all`, and on a
# live run they contain entity-level operational data that should stay local.
data/raw/*.json
!data/raw/.gitkeep
# The hand-exported EXPA snapshot the project was seeded from - same policy as
# data/raw/: real entity-level operational payload, regenerable from the API.
data/expa_analytics_data.json
data/interim/*
!data/interim/.gitkeep

# Everything else IS committed on purpose, so a reviewer can read the processed
# dataset, the predictions, the report tables, the figures and the trained model
# without installing anything or running the pipeline:
#   data/processed/*.csv   outputs/**   models/trained_model.pkl (6 KB)

.streamlit/secrets.toml
