# =============================================================================
# AIESEC Exchange Activity Prediction Platform - environment template
#
#   cp .env.example .env      then fill in the real values.
#   .env is git-ignored and must NEVER be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for live data collection.
# AIESEC GIS / Analytics access token.
# Obtain from EXPA (expa.aiesec.org) - tokens are short-lived and must be
# refreshed. The Analytics API expects it as the `access_token` query parameter.
# -----------------------------------------------------------------------------
AIESEC_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# EXPA office id for AIESEC in India (MC).
# Overrides api.office_id in config/config.yaml.
# Find it via the GIS committees endpoint or the GID documentation.
# -----------------------------------------------------------------------------
AIESEC_OFFICE_ID=

# -----------------------------------------------------------------------------
# OPTIONAL - only needed if you use the OAuth password grant helper instead of
# pasting a token directly. Leave blank to use AIESEC_ACCESS_TOKEN.
# -----------------------------------------------------------------------------
AIESEC_AUTH_URL=
AIESEC_CLIENT_ID=
AIESEC_CLIENT_SECRET=
AIESEC_USERNAME=
AIESEC_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL overrides
# -----------------------------------------------------------------------------
# Override the API base URL (e.g. for a sandbox / proxy).
AIESEC_API_BASE_URL=
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
